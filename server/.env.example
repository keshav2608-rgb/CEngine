# ==============================================================================
# CEngine Server Environment Variables: LOCAL DEVELOPMENT
# Copy to server/.env for local work. Production values are NOT kept in a file:
# they are set in the Render dashboard (see render.yaml) and use a separate database.
# ==============================================================================

# Server Port & Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# PostgreSQL Database URL (e.g. Neon PostgreSQL, Supabase, Render, or local Postgres)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cengine?schema=public"

# JWT Secrets (Generate strong random secrets for production)
JWT_ACCESS_SECRET="dev-access-secret-cengine-replace-in-production"
JWT_REFRESH_SECRET="dev-refresh-secret-cengine-replace-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Storage Configuration
# Set to 'local' for local development uploads folder or 's3' for Cloudflare R2 / AWS S3
STORAGE_PROVIDER="local"
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=15

# S3 / Cloudflare R2 (Optional - only required if STORAGE_PROVIDER="s3")
S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="cengine-media"
S3_ACCESS_KEY_ID="your-r2-access-key-id"
S3_SECRET_ACCESS_KEY="your-r2-secret-access-key"
S3_PUBLIC_URL="https://pub-<hash>.r2.dev"

# Redis URL (Optional - for scaling Socket.IO across multiple backend instances)
# REDIS_URL="redis://localhost:6379"

# Rate Limiting
RATE_LIMIT_MAX=200

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
