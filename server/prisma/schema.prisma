datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

enum ReceiptStatus {
  SENT
  DELIVERED
  READ
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String?
  displayName     String
  avatarUrl       String?
  status          String   @default("Available")
  isEmailVerified Boolean  @default(false)
  googleId        String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastSeenAt      DateTime @default(now())

  // Relations
  refreshTokens       RefreshToken[]
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  roomMembers         RoomMember[]
  sentMessages        Message[]            @relation("SentMessages")
  receipts            MessageReceipt[]
  blockedUsers        Block[]              @relation("UserBlocks")
  blockedBy           Block[]              @relation("BlockedUsers")
  filedReports        Report[]             @relation("ReporterReports")
  reportsReceived     Report[]             @relation("ReportedUserReports")
  scheduledMessages   ScheduledMessage[]
  devices             Device[]
  pushSubscriptions   PushSubscription[]

  @@index([email])
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([userId])
}

model VerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

model Room {
  id          String   @id @default(uuid())
  isGroup     Boolean  @default(false)
  name        String?
  description String?
  avatarUrl   String?
  inviteCode  String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members           RoomMember[]
  messages          Message[]
  scheduledMessages ScheduledMessage[]

  @@index([inviteCode])
}

model RoomMember {
  id                String   @id @default(uuid())
  roomId            String
  room              Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role              Role     @default(MEMBER)
  joinedAt          DateTime @default(now())
  lastReadMessageId String?

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
}

model Message {
  id          String           @id @default(uuid())
  roomId      String
  room        Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User             @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content     String?
  messageType MessageType      @default(TEXT)
  isEdited    Boolean          @default(false)
  isDeleted   Boolean          @default(false)
  replyToId   String?
  replyTo     Message?         @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     Message[]        @relation("MessageReplies")
  metadata    Json?
  /// End-to-end encrypted envelope (ciphertext + per-device wrapped keys). When set, content is null.
  e2ee        Json?
  /// Client-generated id for idempotent sends (retries after a dropped connection)
  clientId    String?
  attachments Attachment[]
  receipts    MessageReceipt[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([senderId, clientId])
  @@index([roomId, createdAt])
  @@index([senderId])
}

model MessageReceipt {
  id        String        @id @default(uuid())
  messageId String
  message   Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    ReceiptStatus @default(SENT)
  updatedAt DateTime      @updatedAt

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId, status])
}

model Attachment {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileUrl   String
  fileName  String
  fileSize  Int
  mimeType  String
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  @@index([messageId])
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("UserBlocks", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlockedUsers", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Report {
  id         String   @id @default(uuid())
  reporterId String
  reporter   User     @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedId String
  reported   User     @relation("ReportedUserReports", fields: [reportedId], references: [id], onDelete: Cascade)
  reason     String
  details    String?
  createdAt  DateTime @default(now())

  @@index([reporterId])
  @@index([reportedId])
}

enum ScheduledStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

/// A message queued by its author to be posted to a room at a later time.
model ScheduledMessage {
  id            String          @id @default(uuid())
  roomId        String
  room          Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User            @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content       String?
  attachments   Json?
  e2ee          Json?
  replyToId     String?
  scheduledFor  DateTime
  status        ScheduledStatus @default(PENDING)
  error         String?
  sentMessageId String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status, scheduledFor])
  @@index([senderId, roomId])
}

/// A browser/device that holds an end-to-end encryption key pair. Only the public key is stored.
model Device {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Base64 SPKI-encoded ECDH P-256 public key
  publicKey  String
  name       String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

/// A browser's Web Push subscription. Pushes never contain message content.
model PushSubscription {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint     String   @unique
  p256dh       String
  auth         String
  /// Rooms this device muted (mute is a per-device preference)
  mutedRoomIds String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}
